# Copy to .env and fill in. Never commit the real .env.
#
# Only a handful of values live in the environment — just what's needed to boot
# the container and reach the database. Everything else (Google OAuth
# credentials, who's allowed to sign in, the upload size limit) is configured
# in the app's UI on first run and stored in the database. When you first open
# the app it walks you through a short setup wizard.

# ---------------------------------------------------------------------------
# Required — the app will not boot without these
# ---------------------------------------------------------------------------

# PostgreSQL connection string. For docker-compose the host is "db" and this is
# assembled from the POSTGRES_* values below, so you don't set it there.
DATABASE_URL="postgresql://tracker:change-me@localhost:5432/tracker?schema=public"

# Session + encryption secret. Generate with: openssl rand -base64 32
# Used to sign sessions AND to encrypt secrets stored in the database, so keep
# it stable — changing it invalidates sessions and stored OAuth credentials.
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Public URL the app is served from (behind your Cloudflare tunnel). If unset,
# the app infers it from request headers. Setting it is recommended in prod.
AUTH_URL="https://tracker.example.com"

# Where uploaded files are stored (local dev). In Docker this is a volume.
UPLOAD_DIR="./uploads"

# ---------------------------------------------------------------------------
# docker-compose only
# ---------------------------------------------------------------------------

# Host port the app is published on (point your Cloudflare tunnel / proxy here).
APP_PORT="3000"
# Interface to bind the published port to. Default localhost-only; set to
# 0.0.0.0 to reach the app from other machines on your LAN.
APP_BIND="127.0.0.1"

# Database container credentials.
POSTGRES_USER="tracker"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="tracker"

# ---------------------------------------------------------------------------
# Configured in the app UI (first-run setup wizard / Settings) — NOT here:
#   - Google OAuth Client ID and Secret
#   - Allowed sign-in emails
#   - Max upload size (MB)
# ---------------------------------------------------------------------------
