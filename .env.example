# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection string. For docker-compose, the host is "db".
DATABASE_URL="postgresql://tracker:change-me@localhost:5432/tracker?schema=public"

# Session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public URL the app is served from (behind your Cloudflare tunnel).
AUTH_URL="https://tracker.example.com"

# Google OAuth credentials (console.cloud.google.com -> Credentials).
# Authorized redirect URI: ${AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated Google account emails allowed to sign in (e.g. you).
ALLOWED_EMAILS="you@gmail.com"

# --- docker-compose database settings ---
POSTGRES_USER="tracker"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="tracker"
